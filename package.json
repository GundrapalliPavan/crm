{
  "name": "crm-platform",
  "version": "0.1.0",
  "private": true,
  "description": "CRM Platform monorepo - api (NestJS), web (Vite + React)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @crm/types build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @crm/api... dev",
    "dev:web": "pnpm --filter @crm/web... dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @crm/api... build",
    "build:web": "pnpm --filter @crm/web... build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm --filter @crm/api test:e2e && pnpm --filter @crm/api test:db && pnpm --filter @crm/api test:e2e:db",
    "db:migrate": "pnpm --filter @crm/api prisma:migrate:dev",
    "db:seed": "pnpm --filter @crm/api db:seed",
    "db:reset": "pnpm --filter @crm/api prisma:reset",
    "bootstrap:admin": "pnpm --filter @crm/api bootstrap:admin",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
