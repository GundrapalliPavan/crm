{
  "expo": {
    "name": "CRM Platform",
    "slug": "crm-platform-mobile",
    "scheme": "crmplatform",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crmplatform.mobile"
    },
    "android": {
      "package": "com.crmplatform.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CRM Platform to use your location to record site visits."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CRM Platform to access your camera to capture visit photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CRM Platform to access your photos to attach visit documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
