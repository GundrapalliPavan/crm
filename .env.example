# Consumed only by docker-compose.yml, to provision the local Postgres container.
#
# Application configuration lives with each app and is NOT read from this file:
#   apps/api/.env.example   (API: NODE_ENV, PORT, API_PREFIX, WEB_ORIGIN, DATABASE_URL)
#   apps/web/.env.example   (web: VITE_API_BASE_URL)

POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_dev
POSTGRES_PORT=5432
