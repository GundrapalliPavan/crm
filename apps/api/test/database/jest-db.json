{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".db-spec.ts$",
  "globalSetup": "<rootDir>/test/database/db-global-setup.ts",
  "setupFiles": ["<rootDir>/test/database/load-test-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "maxWorkers": 1
}
