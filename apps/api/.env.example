# All variables below are required. The API validates them at startup and
# refuses to boot if any is missing or malformed.

# Application
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Browser origin allowed to call this API (CORS).
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_dev?schema=public

# Dedicated database for destructive integration tests. Must end in "_test".
TEST_DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_test?schema=public

# Authentication
# Signs access-token JWTs. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this example value outside local development.
AUTH_JWT_SECRET=dev-only-do-not-use-in-production-64charshexplaceholder0000000000
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Optional first-administrator bootstrap (see README). Leave unset once an
# administrator exists - bootstrap-admin.ts is a no-op without both values.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
