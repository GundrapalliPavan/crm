# All variables below are required. The API validates them at startup and
# refuses to boot if any is missing or malformed.

# Application
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Browser origin allowed to call this API (CORS).
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_dev?schema=public

# Dedicated database for destructive integration tests. Must end in "_test".
TEST_DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_test?schema=public

# Authentication
# Signs access-token JWTs. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this example value outside local development.
AUTH_JWT_SECRET=dev-only-do-not-use-in-production-64charshexplaceholder0000000000
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Optional first-administrator bootstrap (see README). Leave unset once an
# administrator exists - bootstrap-admin.ts is a no-op without both values.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# File storage
# Local-disk root for uploaded files. Optional - defaults to apps/api/uploads
# when unset. A real cloud provider (see README) is a config-free binding
# swap, not an env value.
# STORAGE_LOCAL_PATH=

# Communication providers (see README) - all optional. Each channel degrades
# independently to an honest "not configured" failure when its own variables
# are absent, so leaving all of these unset is a normal, safe state.
# Twilio (WhatsApp + SMS): https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=
# SendGrid (Email): https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
