{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pinned so the seed script and tests cannot widen the inferred root and
    // shift compiled output from dist/main.js to dist/src/main.js.
    "rootDir": "./src",
    // Kept inside outDir so `nest build`'s deleteOutDir clears it too. Left
    // outside, a stale build info file makes tsc skip emit after dist is
    // deleted, producing a silently empty build.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*spec.ts"]
}
